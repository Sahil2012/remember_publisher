# Server
PORT=5000

# Database — PostgreSQL (Supabase: Settings → Database)
# DATABASE_URL is the pooled connection, DIRECT_URL the direct one (used by Prisma migrate)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Auth — Clerk (dashboard.clerk.com → API keys)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# AI revamp — Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key

# Live dictation — Deepgram (console.deepgram.com)
DEEPGRAM_API_KEY=your-deepgram-api-key

# Image storage — Supabase Storage (optional: falls back to local disk if unset)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET_NAME=your-bucket-name

# Billing — Stripe (dashboard.stripe.com → Developers)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx_monthly
STRIPE_YEARLY_PRICE_ID=price_xxx_yearly
